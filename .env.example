# ==========================================
# Supabase — obrigatório
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...

# ==========================================
# URL pública do site — obrigatório
# ==========================================
NEXT_PUBLIC_SITE_URL=https://carreiras.welcome.com.br

# ==========================================
# Resend — e-mails transacionais
# Obrigatório para: confirmação ao candidato,
# notificação ao RH, confirmação de banco de talentos
# Obter em: https://resend.com/api-keys
# ==========================================
RESEND_API_KEY=re_...

# Remetente dos e-mails (domínio verificado no Resend)
# Deixar em branco usa o remetente de teste: onboarding@resend.dev
RESEND_FROM_EMAIL=Welcome Carreiras <carreiras@welcome.com.br>

# E-mail padrão do RH para notificações (pode ser sobrescrito pelo painel admin)
RESEND_RH_EMAIL=rh@welcome.com.br

# ==========================================
# Google Analytics — opcional
# ==========================================
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
